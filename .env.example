# Copiez ce fichier en ".env" (non versionné) et renseignez vos valeurs.
# Attention : toute variable VITE_* est intégrée en clair dans le JavaScript public généré par "yarn build".
VITE_PRIMEVUE_LICENCE=

# --- SEO / site public (facultatif : ces valeurs peuvent aussi être saisies dans site.config.js, committé) ---
# Les variables d'environnement priment sur site.config.js.
VITE_SITE_URL=
VITE_PAYPAL_URL=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
